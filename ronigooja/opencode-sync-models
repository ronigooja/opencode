#!/bin/zsh
set -euo pipefail

if (( $# > 0 )) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
  cat <<'USAGE'
Sync models from an OpenAI-compatible /models endpoint into opencode.json.
The generated provider uses the current OpenCode configuration format.

Required environment variables:
  OPENCODE_MODEL_CATALOG_URL  Model catalog URL, for example https://example.com/v1/models
  OPENCODE_API_KEY            Bearer token for the catalog endpoint

Optional environment variables:
  OPENCODE_CONFIG              OpenCode config path
  OPENCODE_PROVIDER_ID         Provider ID (default: cliproxyapi)
  OPENCODE_PROVIDER_NAME       Provider display name (default: CLIProxyAPI)
  OPENCODE_BASE_URL            Provider API base URL (default: catalog URL without /models)
  OPENCODE_DEFAULT_MODEL       Model to ensure remains present
USAGE
  exit 0
fi

codex_config=${OPENCODE_CODEX_CONFIG:-$HOME/.codex/config.toml}
if [[ -f "$codex_config" ]]; then
  catalog_url_from_codex=$(awk -F'"' '/model_catalog_url[[:space:]]*=/{print $2; exit}' "$codex_config")
  api_key_from_codex=$(awk -F'"' '/experimental_bearer_token[[:space:]]*=/{print $2; exit}' "$codex_config")
  default_model_from_codex=$(awk -F'"' '/^model[[:space:]]*=/{print $2; exit}' "$codex_config")
  base_url_from_codex=$(awk -F'"' '/^base_url[[:space:]]*=/{print $2; exit}' "$codex_config")
fi

catalog_url=${OPENCODE_MODEL_CATALOG_URL:-${catalog_url_from_codex:-}}
api_key=${OPENCODE_API_KEY:-${api_key_from_codex:-}}
if [[ -z "$catalog_url" ]]; then
  print -u2 "OPENCODE_MODEL_CATALOG_URL or model_catalog_url in $codex_config is required"
  exit 1
fi
if [[ -z "$api_key" ]]; then
  print -u2 "OPENCODE_API_KEY or experimental_bearer_token in $codex_config is required"
  exit 1
fi
config=${OPENCODE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json}
provider_id=${OPENCODE_PROVIDER_ID:-cliproxyapi}
provider_name=${OPENCODE_PROVIDER_NAME:-CLIProxyAPI}
base_url=${OPENCODE_BASE_URL:-${base_url_from_codex:-${catalog_url%/models}}}
default_model=${OPENCODE_DEFAULT_MODEL:-${default_model_from_codex:-}}

if [[ ! -f "$config" ]]; then
  print -u2 "OpenCode config not found: $config"
  exit 1
fi

response=$(mktemp /tmp/opencode-models.XXXXXX)
updated=$(mktemp /tmp/opencode-config.XXXXXX)
trap 'rm -f "$response" "$updated"' EXIT

curl -fsS --connect-timeout 10 --max-time 30 \
  -H "Authorization: Bearer $api_key" \
  "$catalog_url" > "$response"

models=$(jq -c '
  def title_words: split(" ") | map((.[0:1] | ascii_upcase) + .[1:]) | join(" ");
  def pretty_name:
    if test("^gpt-") then
      (sub("^gpt-"; "") | gsub("-"; " ") | title_words | "GPT-" + .)
    elif test("^claude-[0-9]+-[0-9]+-") then
      (capture("^claude-(?<major>[0-9]+)-(?<minor>[0-9]+)-(?<family>[a-z]+)(?:-(?<date>[0-9]{8}))?$")
       | "Claude \(.major).\(.minor) \(.family | title_words)"
       + (if .date then " (\(.date[0:4])-\(.date[4:6])-\(.date[6:8]))" else "" end))
    elif test("^claude-[a-z]+-[0-9]+-[0-9]{8}$") then
      (capture("^claude-(?<family>[a-z]+)-(?<major>[0-9]+)-(?<date>[0-9]{8})$")
       | "Claude \(.family | title_words) \(.major)"
       + " (\(.date[0:4])-\(.date[4:6])-\(.date[6:8]))")
    elif test("^claude-[a-z]+-") then
      (capture("^claude-(?<family>[a-z]+)-(?<major>[0-9]+)(?:-(?<minor>[0-9]+))?(?:-(?<date>[0-9]{8}))?$")
       | "Claude \(.family | title_words) \(.major)"
       + (if .minor then ".\(.minor)" else "" end)
       + (if .date then " (\(.date[0:4])-\(.date[4:6])-\(.date[6:8]))" else "" end))
    else .
    end;
  (.data // .models // [])
  | map(select(.id | type == "string"))
  | map(select(.id | test("^(gpt-image|codex-auto-review)") | not))
  | unique_by(.id)
  | map(. as $model | {
      key: .id,
      value: ({name: (.id | pretty_name)}
        + (if (.created | type) == "number" then {releaseDate: (.created | todateiso8601[0:10])} else {} end)
        + ({
            context: (["context_length", "context_window", "max_context_length", "context"]
              | map(. as $key | $model[$key] | if type == "number" and isfinite and . > 0 then floor else null end)
              | map(select(. != null)) | first),
            output: (["max_output_length", "max_tokens", "output_token_limit", "output"]
              | map(. as $key | $model[$key] | if type == "number" and isfinite and . > 0 then floor else null end)
              | map(select(. != null)) | first)
          } | with_entries(select(.value != null))
          | if length == 0 then {} else {limit: .} end))
    })
  | from_entries
' "$response")

if [[ "$models" == "{}" ]]; then
  print -u2 "No chat models returned by $catalog_url"
  exit 1
fi

jq \
  --arg provider_id "$provider_id" \
  --arg provider_name "$provider_name" \
  --arg base_url "$base_url" \
  --arg api_key "$api_key" \
  --arg default_model "$default_model" \
  --argjson models "$models" \
  '(.providers // {}) as $providers
   | (.provider // {}) as $legacy_providers
   | (($providers[$provider_id].models // {}) + ($legacy_providers[$provider_id].models // {})) as $existing_models
   | .providers = $providers
   | .providers[$provider_id] = ((.providers[$provider_id] // {})
       + {
           name: $provider_name,
           package: "@opencode/ai/providers/openai-compatible",
           settings: ((.providers[$provider_id].settings // {})
             + {baseURL: $base_url, apiKey: $api_key}),
           models: ($models | to_entries
             | map(. as $entry
                 | ($existing_models[$entry.key] // {}) as $base
                 | ($entry.value.limit // {}) as $limit
                 | {key: $entry.key, value:
                     (($base * $entry.value)
                       + (if ($limit | length) == 0
                          then {}
                          else {limit: (($base.limit // {}) * $limit)}
                          end))})
             | from_entries)
         })
   | if $default_model != "" then
       .providers[$provider_id].models[$default_model] //= {name: $default_model}
     else . end
   | del(.provider[$provider_id])
   | if (.provider // {}) == {} then del(.provider) else . end
  ' "$config" > "$updated"

chmod 600 "$updated"
mv "$updated" "$config"
chmod 600 "$config"
print "Synced $(jq 'length' <<< "$models") models to $config"
